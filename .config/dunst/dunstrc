[global]
    monitor = 0
    follow = mouse

    width = 350
    height = 300
    origin = top-right
    offset = 15x15

    notification_limit = 10

    font = JetBrainsMono Nerd Font Mono 10
    line_height = 2

    separator_height = 1
    padding = 12
    horizontal_padding = 12
    frame_width = 2
    corner_radius = 0

    markup = yes
    format = "<b>%s</b>\n%b"

    show_age_threshold = 60
    word_wrap = yes

    mouse_left_click = do_action, close_current
    mouse_middle_click = close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#111111"
    foreground = "#AAAAAA"
    frame_color = "#444444"
    timeout = 4

[urgency_normal]
    background = "#111111CC"
    foreground = "#FFFFFF"
    frame_color = "#888888"
    timeout = 8

[urgency_critical]
    background = "#FFFFFF"
    foreground = "#000000"
    frame_color = "#000000"
    timeout = 0
